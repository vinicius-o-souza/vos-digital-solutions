{% stories Alert with {
  title: 'Alert',
  description: 'A customizable Bootstrap alert component with different types.',
  args: {
    type: 'primary',
    heading: 'Default Alert Heading',
    content: 'This is a default alert.',
    dismissible: true,
  },
  argTypes: {
    type: {
      name: 'Type',
      description: 'The Bootstrap alert type.',
      control: 'select',
      options: ['primary', 'secondary', 'success', 'danger', 'warning', 'info', 'light', 'dark']
    },
    heading: {
      name: 'Heading',
      description: 'The heading text for the alert.',
      control: 'text'
    },
    dismissible: {
      name: 'Dismissible',
      description: 'Whether the alert is dismissible.',
      control: 'boolean'
    },
    content: {
      name: 'Content',
      description: 'The content of the alert.'
    }
  }
} %}


  {% story primary with {
    name: 'Primary',
    args: {
      type: 'primary',
      heading: 'Alert Heading',
      content: 'Alert Content'
    }
  } %}
    {% include 'vos_base:alert' with { type: type, heading: heading, content: content } %}
  {% endstory %}

