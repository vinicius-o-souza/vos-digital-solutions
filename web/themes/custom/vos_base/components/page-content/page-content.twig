{#
/**
 * @file
 * Template for page-content component.
 *
 * Available config:
 * - content_attributes: HTML attributes for the main content area of the page.
 * - page_main_utility_classes: An array of utility classes.
 *
 * Available blocks:
 * - content_top
 * - sidebar_left
 * - page_content
 * - sidebar_right
 * - content_bottom
 */
#}

{% set page_main_classes = []|merge(page_main_utility_classes ?: []) %}

<main{{content_attributes.addClass(page_main_classes)}}>
  <div class="row">
    {% if page.content_top %}
      <div class="page__content page__content--top col-12" id="main-content--top">
        {% block page_content_top %}
          {{ page.content_top }}
        {% endblock %}
      </div>
    {% endif %}

    {% if page.sidebar_left %}
      {% set page_sidebar_left_classes = [
        'col-12',
        page.content ? 'col-lg-4' : 'col-lg-12',
      ] %}
      <aside class="page__sidebar page__sidebar--left {{ page_sidebar_left_classes|join(' ') }}">
        {% block sidebar_left %}
          {{ page.sidebar_left }}
        {% endblock %}
      </aside>
    {% endif %}

    {% if page.content %}
      {% set page_content_main_classes = [
        'col-12',
        page.sidebar_left and page.sidebar_right ? 'col-lg-6' : (page.sidebar_left or page.sidebar_right ? 'col-lg-8' : 'col-lg-12'),
      ] %}
      <div class="page__content page__content--main {{ page_content_main_classes|join(' ') }}" id="main-content">
        {% block page_content %}
          {{ page.content }}
        {% endblock %}
      </div>
    {% endif %}

    {% if page.sidebar_right %}
      {% set page_sidebar_right_classes = [
        'col-12',
        page.content ? 'col-lg-4' : 'col-lg-12',
      ] %}
      <aside class="page__sidebar page__sidebar--right {{ page_sidebar_right_classes|join(' ') }}">
        {% block sidebar_right %}
          {{ page.sidebar_right }}
        {% endblock %}
      </aside>
    {% endif %}
  </div>

  {% if page.content_bottom %}
    <div class="page__content page__content--bottom" id="main-content--bottom">
      {% block page_content_bottom %}
        {{ page.content_bottom }}
      {% endblock %}
    </div>
  {% endif %}
</main>
