{#
/**
 * @file
 * Template for the main page.
 *
 * Available variables:
 * - page_attributes: HTML attributes for the page component.
 * - page_utility_classes: An array of utility classes that can be added to the page element.
 *
 * Available blocks:
 * - page_header
 * - page_content
 * - page_footer
 */
#}
{% set page_attributes = attributes ?: create_attribute() %}
{% set 
  page_classes = [
    'page',
  ]|merge(page_utility_classes ?: []) 
%}

<div {{ page_attributes.addClass(page_classes) }}>

  {% block page_header %}
		{% include 'vos_base:page-header' %}
	{% endblock %}

  {% block page_content %}
    {% include 'vos_base:page-content' %}
  {% endblock %}

  {% block page_footer %}
    {% include 'vos_base:page-footer' %}
	{% endblock %}

</div>
