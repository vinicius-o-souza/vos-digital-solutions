{#
/**
 * @file
 * Template for a Page Footer component.
 *
 * Available config:
 * - footer_attributes: HTML attributes for the footer content area of the page.
 * - footer_utility_classes: An array of utility classes.
 *
 * Available blocks:
 * - footer_top
 * - footer_middle
 * - footer_bottom
 */
#}
{% set footer_attributes = footer_attributes ?: create_attribute() %}
{%
  set footer_classes = [
    'page__footer',
  ]|merge(footer_utility_classes ?: [])
%}

<footer {{ footer_attributes.addClass(footer_classes) }}>
  <div class="container">
    <div class="d-flex flex-wrap justify-content-md-between align-items-md-center">
      {% if page.footer_top %}
        {% block footer_top %}
          {{ page.footer_top }}
        {% endblock %}
      {% endif %}

      {% if page.footer_middle %}
        {% block footer_middle %}
          {{ page.footer_middle }}
        {% endblock %}
      {% endif %}

      {% if page.footer_bottom %}
        {% block footer_bottom %}
          {{ page.footer_bottom }}
        {% endblock %}
      {% endif %}
    </div>
  </div>
</footer>
