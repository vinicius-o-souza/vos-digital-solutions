{#
/**
 * @file
 * Template for page-content component.
 *
 * Available config:
 * - content_attributes: HTML attributes for the main content area of the page.
 * - page_content_container_attributes: HTML attributes for the container area of the page.
 * - page_content_container_type: sm | md | lg | xl | xxl | fluid | false | true.
 * - page_content_container_utility_classes: An array of utility classes.
 * - page_main_utility_classes: An array of utility classes.
 *
 * Available blocks:
 * - content_top
 * - sidebar_left
 * - page_content
 * - sidebar_right
 * - content_bottom
 */
#}
{% set page_content_container_attributes = page_content_container_attributes ?: create_attribute() %}
{% set page_main_classes = []|merge(page_main_utility_classes ?: []) %}


{% set content_container_class = '' %}
{% if page_content_container_type is null %}
  {% set content_container_class = 'container' %}
{% elseif page_content_container_type is not empty %}
  {% set content_container_class = 'container-' ~ page_content_container_type %}
{% endif %}
{%
  set page_content_container_classes = [
    content_container_class
  ]|merge(page_content_container_utility_classes ?: [])
%}

<main{{content_attributes.addClass(page_main_classes)}}>
  <div {{ page_content_container_attributes.addClass(page_content_container_classes) }}>
    {% if page.content_top %}
      <div class="page__content page__content--top" id="main-content--top">
        {% block page_content_top %}
          {{ page.content_top }}
        {% endblock %}
      </div>
    {% endif %}

    <div class="container">
      <div class="row">
        {% if page.sidebar_left %}
          {% set page_sidebar_left_classes = [
            'col-12',
            page.content ? 'col-lg-4' : 'col-lg-12',
          ] %}
          <aside class="page__sidebar page__sidebar--left {{ page_sidebar_left_classes|join(' ') }}">
            {% block sidebar_left %}
              {{ page.sidebar_left }}
            {% endblock %}
          </aside>
        {% endif %}

        {% if page.content %}
          {% set page_content_main_classes = [
            'col-12',
            page.sidebar_left and page.sidebar_right ? 'col-lg-6' : (page.sidebar_left or page.sidebar_right ? 'col-lg-8' : 'col-lg-12'),
          ] %}
          <div class="page__content page__content--main {{ page_content_main_classes|join(' ') }}" id="main-content">
            {% block page_content %}
              {{ page.content }}
            {% endblock %}
          </div>
        {% endif %}

        {% if page.sidebar_right %}
          {% set page_sidebar_right_classes = [
            'col-12',
            page.content ? 'col-lg-4' : 'col-lg-12',
          ] %}
          <aside class="page__sidebar page__sidebar--right {{ page_sidebar_right_classes|join(' ') }}">
            {% block sidebar_right %}
              {{ page.sidebar_right }}
            {% endblock %}
          </aside>
        {% endif %}
      </div>
    </div>

    {% if page.content_bottom %}
      <div class="page__content page__content--bottom" id="main-content--bottom">
        {% block page_content_bottom %}
          {{ page.content_bottom }}
        {% endblock %}
      </div>
    {% endif %}
  </div>
</main>
